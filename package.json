{
  "name": "@lalss/sections-kit",
  "version": "0.1.0",
  "description": "Shared section types + renderers for lalss link-pages, landing-pages, and webstore editors. Federation source of truth.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./animation": {
      "types": "./dist/shared/animation/index.d.ts",
      "import": "./dist/shared/animation/index.js"
    },
    "./motion": {
      "types": "./dist/shared/motion.d.ts",
      "import": "./dist/shared/motion.js"
    },
    "./effects": {
      "types": "./dist/shared/effects/index.d.ts",
      "import": "./dist/shared/effects/index.js"
    },
    "./interactive": {
      "types": "./dist/shared/interactive/index.d.ts",
      "import": "./dist/shared/interactive/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-css.mjs",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalss-dev/sections-kit.git"
  },
  "license": "UNLICENSED"
}
